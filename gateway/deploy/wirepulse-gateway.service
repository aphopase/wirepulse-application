# Install: copy to /etc/systemd/system/, adjust the paths and WIREPULSE_SERIAL_PATH, then
#   sudo systemctl daemon-reload && sudo systemctl enable --now wirepulse-gateway
# The token is read from a file only the service user can read, not from the environment or this unit file:
#   sudo useradd --system --home /opt/wirepulse --shell /usr/sbin/nologin wirepulse-gw
#   sudo install -d -m 0750 -o root -g wirepulse-gw /etc/wirepulse
#   sudo sh -c 'umask 027; cat > /etc/wirepulse/gateway.token'    (paste the wpg_… token, Enter, Ctrl-D)
#   sudo chgrp wirepulse-gw /etc/wirepulse/gateway.token
[Unit]
Description=WirePulse gateway agent
After=network-online.target
Wants=network-online.target
# Give up after 5 failed starts in 10 minutes. A revoked or rotated token ends the agent with an error; retrying
# forever would only feed the server's authentication-failure rate limiter.
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
User=wirepulse-gw
Group=wirepulse-gw
# Access to /dev/ttyUSB*; on some distributions the group is "uucp".
SupplementaryGroups=dialout
WorkingDirectory=/opt/wirepulse/gateway
Environment=WIREPULSE_API_URL=https://api.wirepulse.example.com
Environment=WIREPULSE_SERIAL_PATH=/dev/ttyUSB0
Environment=WIREPULSE_GATEWAY_TOKEN_FILE=/etc/wirepulse/gateway.token
ExecStart=/usr/bin/node src/agent.mjs
Restart=on-failure
RestartSec=30
# On SIGTERM the agent finishes or abandons the running job within WIREPULSE_SHUTDOWN_GRACE_MS (default 30 s).
TimeoutStopSec=45
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
